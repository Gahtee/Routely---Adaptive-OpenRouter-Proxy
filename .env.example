OPENROUTER_API_KEY=
ROUTER_API_KEY=

PORT=4000

# Optional price caps for dynamic-balanced only (USD per 1M tokens).
# Unset (or empty/invalid) = no limit, keeps current behavior.
# Example: BALANCED_MAX_INPUT_PRICE=1 BALANCED_MAX_OUTPUT_PRICE=5
BALANCED_MAX_INPUT_PRICE=
BALANCED_MAX_OUTPUT_PRICE=

# Adaptive history for dynamic-balanced (bounded multiplier over static score).
# Confidence = min(observations / HISTORY_MIN_OBSERVATIONS, 1).
HISTORY_MIN_OBSERVATIONS=20
HISTORY_MIN_FUNCTIONAL_OBSERVATIONS=3
HISTORY_MIN_ADJUSTMENT=0.80
HISTORY_MAX_ADJUSTMENT=1.05
HISTORY_TRUNCATED_WEIGHT=0.10
HISTORY_ERROR_WEIGHT=0.15
HISTORY_EMPTY_WEIGHT=0.10
HISTORY_REASONING_WEIGHT=0.05
HISTORY_COST_WEIGHT=0.10
HISTORY_FUNCTIONAL_SUCCESS_WEIGHT=0.05
HISTORY_FUNCTIONAL_FAILURE_WEIGHT=0.10
